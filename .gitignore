# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/

# Data (raw data files usually not committed — track via SOURCE.md/download
# scripts instead). Ignore by extension, not by blanket directory, so
# SOURCE.md files (docs, not data) stay tracked without needing a
# directory-unignore workaround.
data/raw/**/*.csv
data/raw/**/*.csv.gz
data/raw/**/*.tsv
data/raw/**/*.tsv.gz
data/raw/**/*.txt
data/raw/**/*.txt.gz
data/raw/**/*.gz
data/raw/**/*.zip
data/raw/**/*.parquet
data/processed/*
!data/processed/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Docker
*.log

# Office lock files
~$*
~$*.doc*
~$*.ppt*
~$*.xls*

# General temporary files
*.tmp
*.bak

DRAFT*
.claude/worktrees/
instructor/student_submissions/*
