configfile: "config.yaml"

SITES = config["sites"]


rule all:
    input:
        "results/hba1c_by_site.png",


rule clean_site:
    input:
        "data/sites/{site}.tsv",
    output:
        "results/clean/{site}.tsv",
    params:
        max_sbp=config["max_sbp"],
    shell:
        "python scripts/clean_site.py --input {input} --output {output} --max-sbp {params.max_sbp}"


rule summarize_site:
    input:
        "results/clean/{sample}.tsv",
    output:
        "results/summary/{site}.tsv",
    shell:
        "python scripts/summarize_site.py --input {input} --output {output} --site {wildcards.site}"


rule combine_summaries:
    input:
        "results/summary/{site}.tsv",
    output:
        "results/all_sites.tsv",
    shell:
        "python scripts/combine_summaries.py --inputs {input} --output {output}"


rule plot_summary:
    input:
        "results/all_sites.tsv",
    output:
        "results/hba1c_by_site.png",
    shell:
        "python scripts/plot_summary.py --input {input} --output results/hba1c.png"
