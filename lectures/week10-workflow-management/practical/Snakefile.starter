# Starter Snakefile. Rule 1 is done for you; fill in the TODOs.
configfile: "config.yaml"

SITES = config["sites"]


rule all:
    input:
        "results/hba1c_by_site.png",


rule clean_site:
    input:
        "data/sites/{site}.tsv",
    output:
        "results/clean/{site}.tsv",
    params:
        max_sbp=config["max_sbp"],
    shell:
        "python scripts/clean_site.py --input {input} --output {output} --max-sbp {params.max_sbp}"


